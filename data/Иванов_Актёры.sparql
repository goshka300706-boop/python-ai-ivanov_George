SELECT DISTINCT ?actor ?actorLabel ?birthCountryLabel (YEAR(NOW()) - YEAR(?birthDate) AS ?age) WHERE {
  # Актёры с наградами
  ?actor wdt:P106 wd:Q33999.  # Профессия: актёр
  ?actor p:P166 ?awardStatement.  # Награды актёра
  ?awardStatement ps:P166 ?award.

  # Актёры, снимавшиеся в фильмах не только в США
  ?film wdt:P161 ?actor.  # Актёр снимался в фильме
  ?film wdt:P495 ?country.  # Страна происхождения фильма
  FILTER(?country != wd:Q30)  # Исключаем США

  # Страна рождения актёра
  OPTIONAL {
    ?actor wdt:P19 ?birthPlace.  # Место рождения
    ?birthPlace wdt:P17 ?birthCountry.  # Страна места рождения
  }

  # Дата рождения актёра (для расчёта возраста)
  ?actor wdt:P569 ?birthDate.

  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
}
LIMIT 100
